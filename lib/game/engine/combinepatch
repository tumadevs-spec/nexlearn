```ts
  // A combine puzzle can only use clues the child has collected, so the
  // puzzle must require every clue it asks for.
  for (const i of items) {
    if (i.puzzle.type !== "combine") continue;
    for (const clue of i.puzzle.config.clues ?? []) {
      if (!evidenceIds.has(clue)) {
        report.issues.push(
          `puzzle "${i.puzzle.id}": combine clue "${clue}" ` +
          "is not an evidence id");
      } else if (!i.place.requires.includes(clue)) {
        i.place.requires.push(clue);
        report.repairs.push(
          `"${i.puzzle.id}": now requires combine clue "${clue}"`);
      }
    }
  }
