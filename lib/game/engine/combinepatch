## 2. Tests (add to the validator test file, before the final `console.log`)

```js
run("combine puzzle passes and requires its clues",
  (s) => {
    s.puzzles[3] = {
      id: "puzzle_final", type: "combine",
      prompt: "Which two clues show why the robot stopped?",
      config: {clues: ["ev_1", "ev_3"]},
      feedbackCorrect: "Yes!", feedbackWrong: "Look again.",
      hint: "Check the tray and the label.", skill: "reasoning",
      name: "Case board", x: 0.70, y: 0.34, sceneText: "Put it together.",
      requires: ["puzzle_3"], lockedText: "Solve the parts first.",
    };
  },
  (r) => {
    assert.deepEqual(r.issues, []);
    const spot = r.spec.entities.find((e) => e.puzzleId === "puzzle_final");
    assert.ok(spot.requires.includes("ev_1"));
    assert.ok(spot.requires.includes("ev_3"));
    assert.deepEqual(r.spec.puzzles[3].config.clues, ["ev_1", "ev_3"]);
  });

run("combine with an unknown clue id is rejected",
  (s) => {
    s.puzzles[3].type = "combine";
    s.puzzles[3].config = {clues: ["ev_1", "ev_99"]};
  },
  (r) => assert.ok(has(r.issues, "combine clue")));

run("combine with one clue is rejected",
  (s) => {
    s.puzzles[3].type = "combine";
    s.puzzles[3].config = {clues: ["ev_1"]};
  },
  (r) => assert.ok(has(r.issues, "clues")));
```

